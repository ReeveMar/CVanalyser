# =====================================================================
# Production Environment Configuration for CV Analyser
# Copy this file to .env.prod on your Ubuntu server: cp .env.prod.example .env.prod
# =====================================================================

# Server & Environment
ENVIRONMENT=production
DOMAIN_NAME=cvanalyser.yourdomain.com
COOKIE_SECURE=true

# Security - Generate a strong secret key using: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_A_SECURE_64_CHAR_HEX_KEY

# PostgreSQL 16 Database
POSTGRES_USER=cvanalyser
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_DB_PASSWORD
POSTGRES_DB=cvanalyser

# Redis Cache Security
REDIS_PASSWORD=REPLACE_WITH_A_STRONG_REDIS_PASSWORD

# AWS S3 Object Storage Configuration
AWS_ACCESS_KEY_ID=REPLACE_WITH_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-cvanalyser-uploads-bucket

# AI Provider Configuration (Bedrock or OpenAI)
BEDROCK_API_KEY=
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1

# Alternative / Fallback OpenAI Provider:
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
