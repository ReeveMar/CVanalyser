# ==========================================
# Development Environment Configuration
# ==========================================

# AI Service Configuration
BEDROCK_API_KEY="<provide your Bedrock API key>"
BEDROCK_BASE_URL="https://bedrock-mantle.<your-region>.api.aws/v1"
# Fallback / Alternative OpenAI configuration:
# OPENAI_API_KEY="<your-openai-api-key>"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Database & Cache
# For SQLite (default development):
DATABASE_URL="sqlite:///./sql_app.db"
# For PostgreSQL:
# DATABASE_URL="postgresql+psycopg2://cvanalyser:password@localhost:5432/cvanalyser"
REDIS_URL="redis://localhost:6379/0"

# AWS S3 Object Storage
AWS_ACCESS_KEY_ID="<your-aws-access-key-id>"
AWS_SECRET_ACCESS_KEY="<your-aws-secret-access-key>"
AWS_REGION="your-aws-region"
S3_BUCKET_NAME="<your-s3-bucket-name>"
# Optional custom endpoint (MinIO / LocalStack):
# AWS_ENDPOINT_URL="http://localhost:9000"

# Authentication & Security
ENVIRONMENT="development"
SECRET_KEY="YOUR_SUPER_SECRET_KEY_HERE_FOR_DEVELOPMENT"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"
COOKIE_SECURE="false"
CORS_ORIGINS="http://localhost:5173,http://localhost:8000"